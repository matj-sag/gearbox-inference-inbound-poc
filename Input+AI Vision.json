 ONNX input\n        temp,                   // out1\n        torque,                 // out2\n    ];\n}"}]},{"id":"apama.analyticskit.blocks.cumulocity.CreateAlarm","key":-6,"type":"C8YDevice Block","location":"856 -272","blockType":"c8y_Output","parameters":[{"id":"deviceId","c8y_type":"c8y_deviceIdOrCurrentDevice","value":"11371275"},{"id":"alarmType","value":"gearboxAlarm"},{"id":"alarmSeverity","value":"MAJOR"}],"categoryId":"Output"},{"id":"apamax.analyticsbuilder.samples.ONNX","key":-7,"type":"Analytics Block","location":"56 -408","categoryId":"Calculations","parameters":[{"id":"onnxModelFile","value":"gearbox_model.onnx"}]},{"id":"apamax.analyticsbuilder.samples.SmartFunction","key":-8,"type":"Analytics Block","location":"328 -552","categoryId":"Calculations","parameters":[{"id":"label","value":"Decision Smart Function"},{"id":"smartFunction","c8y_type":"pab_codeEditor_javascript","value":"export function onInput(inputs, context) {\n    const raw = String(inputs[0] || \"[]\");\n    const temp = Number(inputs[1] || 0);\n    const torque = Number(inputs[2] || 0);\n    const cls = Number(inputs[3] || 0);\n    const conf = Number(inputs[4] || 0);\n\n    const labelMap = {\n        0: \"normal\",\n        1: \"early_bearing_wear\",\n        2: \"gear_tooth_damage\",\n        3: \"misalignment\"\n    };\n\n    const label = labelMap[cls] || \"unknown\";\n\n    const good = (cls === 0) && (conf > 0.80);\n\n    if (good) {\n        return [temp, torque, good];\n    }\n\n    // Construct LLM prompt\n    const prompt = `\nWind turbine gearbox anomaly detected.\nModel classification: ${label}\nConfidence: ${conf.toFixed(3)}\nRaw features: ${raw}\nTemperature: ${temp}\nTorque: ${torque}\n\nProvide a likely root cause, probable secondary effects, and clear recommended diagnostic steps for a field engineer.\n    `.trim();\n\n    return [null, null, good, prompt];\n}"}]},{"id":"apama.analyticskit.blocks.core.Not","key":-9,"type":"Analytics Block","location":"656 -392","cat