  if (bin.length < 40) {\n        // 10 float32 values expected\n        return [];\n    }\n\n    const dv = new DataView(bin.buffer);\n    const values = [];\n    for (let i = 0; i < 10; i++) {\n        values.push(dv.getFloat32(i * 4, false));\n    }\n\n    // Prepare outputs for ONNX and second JS\n    const temp = values[8];\n    const torque = values[9];\n\n    return [\n        JSON.stringify([values]), // out0 → ONNX input\n        temp,                   // out1\n        torque,                 // out2\n    ];\n}\n"}]},{"id":"apama.analyticskit.blocks.cumulocity.CreateAlarm","key":-6,"type":"C8YDevice Block","location":"1072 -272","blockType":"c8y_Output","parameters":[{"id":"deviceId","c8y_type":"c8y_deviceIdOrCurrentDevice","value":{"id":"MP_okb4wyh10","type":"TemplateParameterReference"}},{"id":"alarmType","value":"gearboxAlarm"},{"id":"alarmSeverity","value":"MAJOR"}],"categoryId":"Output"},{"id":"apamax.analyticsbuilder.samples.ONNX","key":-7,"type":"Analytics Block","location":"64 -408","categoryId":"Calculations","parameters":[{"id":"onnxModelFile","value":{"id":"MP_6sno0vepn","type":"TemplateParameterReference"}}]},{"id":"apamax.analyticsbuilder.samples.SmartFunction","key":-8,"type":"Analytics Block","location":"328 -552","categoryId":"Calculations","parameters":[{"id":"label","value":"Decision Smart Function"},{"id":"smartFunction","c8y_type":"pab_codeEditor_javascript","value":"export function onInput(inputs, context) {\n    const raw = String(inputs[0].value || \"[]\");\n    const temp = Number(inputs[1].value || 0);\n    const torque = Number(inputs[2].value || 0);\n    const cls = Number(inputs[3].value || 0);\n    const conf = Number(inputs[4].value || 0);\n\n    const labelMap = {\n        0: \"normal\",\n        1: \"early_bearing_wear\",\n        2: \"gear_tooth_damage\",\n        3: \"misalignment\"\n    };\n\n    const label = labelMap[cls] || \"unknown\";\n\n    const good = (cls === 0);\n\n    if (good) {\n        return [temp, torque, good];\n    }\n\n    // Construct LLM prompt\n    const prompt = `\nWind turbine gearbox anomaly detected.\nModel classification: ${label}\nConfidence: ${conf.toFixed(3)}\nRaw features: ${raw}\nTemperature: ${temp}\nTorque: ${torque}\n\nProvide a likely root cause, probable secondary effects, and clear recommended diagnostic steps for a field engineer.\n    `.trim();\n\n    return [temp, torque, good, prompt];\n}\n"}]},{"id":"apama.analyticskit.blocks.cumulocity.CreateMeasurement","key":-10,"type":"C8YDevice Block","location":"856 -528","blockType":"c8y_Output","parameters":[{"id":"deviceId","c8y_type":"c8y_deviceIdOrCurrentDevice","value":{"id":"MP_okb4wyh10","type":"TemplateParameterReference"}},{"id":"fragment","value":"c8y_Torque"},{"id":"series","value":"c8y_Torque"}],"categoryId":"Output"},{"id":"apamax.analyticsbuilder.samples.Logger","key":-11,"type":"Analytics Block","location":"64 -576","categoryId":"Utilities","parameters":[{"id":"loggerTag","value":"DecodeTemp"},{"id":"logLevel","value":"INFO"},{"id":"disableOutput","value":{"id":"MP_c632nb5n5","type":"TemplateParameterReference"}}]},{"id":"apamax.analyticsbuilder.samples.Logger","key":-12,"type":"Analytics Block","location":"64 -632","categoryId":"Utilities","parameters":[{"id":"loggerTag","value":"DecodeTorque"},{"id":"logLevel","value":"INFO"},{"id":"disableOutput","value":{"id":"MP_c632nb5n5","type":"TemplateParameterReference"}}]},{"id":"apamax.analyticsbuilder.samples.Logger","key":-13,"type":"Analytics Block","location":"328 -224","categoryId":"Utilities","parameters":[{"id":"loggerTag","value":"ModelClass"},{"id":"logLevel","value":"INFO"},{"id":"disableOutput","value":{"id":"MP_c632nb5n5","type":"TemplateParameterReference"}}]},{"id":"apamax.analyticsbuilder.samples.Logger","key":-14,"type":"Analytics Block","location":"328 -280","categoryId":"Utilities","parameters":[{"id":"loggerTag","value":"ModelConfidence"},{"id":"logLevel","value":"INFO"},{"id":"disableOutput","value":{"id":"MP_c632nb5n5",